{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "watchtower-daily-brief",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "watchtower.damao.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchtower-daily-brief-db",
      "database_id": "74613d5c-db42-40e4-9810-e73bbd716bd3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BRIEF_AUDIO",
      "bucket_name": "watchtower-brief-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BRIEF_AUDIO_QUEUE",
        "queue": "watchtower-brief-audio-jobs"
      },
      {
        "binding": "BRIEF_PUSH_QUEUE",
        "queue": "watchtower-brief-push-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "watchtower-brief-audio-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "watchtower-brief-push-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60
      }
    ]
  },
  "ratelimits": [
    {
      "name": "MOBILE_PUSH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "BRIEF_AUDIO_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "TAVILY_API_KEY",
      "DEEPSEEK_API_KEY",
      "WATCHTOWER_FEEDBACK_TOKEN",
      "MIMO_API_KEY",
      "APNS_TEAM_ID",
      "APNS_KEY_ID",
      "APNS_PRIVATE_KEY",
      "PUSH_TOKEN_ENCRYPTION_KEY",
      "PUSH_TOKEN_HMAC_KEY"
    ]
  },
  "triggers": {
    "crons": ["0 21 * * *", "30 22 * * *", "30 23 * * *", "30 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
