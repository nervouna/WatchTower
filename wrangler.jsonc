{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "watchtower-daily-brief",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "watchtower.damao.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchtower-daily-brief-db",
      "database_id": "74613d5c-db42-40e4-9810-e73bbd716bd3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BRIEF_AUDIO",
      "bucket_name": "watchtower-brief-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BRIEF_AUDIO_QUEUE",
        "queue": "watchtower-brief-audio-jobs"
      },
      {
        "binding": "BRIEF_PUSH_QUEUE",
        "queue": "watchtower-brief-push-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "watchtower-brief-audio-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "watchtower-brief-push-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60
      }
    ]
  },
  "ratelimits": [
    {
      "name": "MOBILE_PUSH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "BRIEF_AUDIO_ENABLED": "true",
    "AUTH0_ISSUER": "https://auth.watchtower.damao.io/",
    "AUTH0_TENANT_DOMAIN": "dev-to70scnda2czaona.us.auth0.com",
    "AUTH0_AUDIENCE": "https://watchtower.damao.io/api",
    "AUTH0_WEB_CLIENT_ID": "xk9v7BQhHNo4Us27srWAifkxIZTtHPhL",
    "AUTH0_MOBILE_DEV_CLIENT_ID": "xVjFpJiKSjIgwf6we3IJ2V4ciQUIRvAU",
    "AUTH0_MOBILE_PROD_CLIENT_ID": "qdjaZq0j2lxZxcbSsPOqx8VKU6irFLKt"
  },
  "secrets": {
    "required": [
      "TAVILY_API_KEY",
      "DEEPSEEK_API_KEY",
      "AUTH0_MANAGEMENT_CLIENT_ID",
      "AUTH0_MANAGEMENT_CLIENT_SECRET",
      "MIMO_API_KEY",
      "APNS_TEAM_ID",
      "APNS_SANDBOX_KEY_ID",
      "APNS_SANDBOX_PRIVATE_KEY",
      "APNS_PRODUCTION_KEY_ID",
      "APNS_PRODUCTION_PRIVATE_KEY",
      "PUSH_TOKEN_ENCRYPTION_KEY",
      "PUSH_TOKEN_HMAC_KEY"
    ]
  },
  "triggers": {
    "crons": ["0 21 * * *", "30 22 * * *", "30 23 * * *", "30 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "dev": {
      "name": "watchtower-daily-brief-dev",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "dev.watchtower.damao.io",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "watchtower-daily-brief-dev-db",
          "database_id": "1e5e4a2f-c857-4d54-a3d3-942d03068d86",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BRIEF_AUDIO",
          "bucket_name": "watchtower-brief-audio-dev"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "BRIEF_AUDIO_QUEUE",
            "queue": "watchtower-brief-audio-jobs-dev"
          },
          {
            "binding": "BRIEF_PUSH_QUEUE",
            "queue": "watchtower-brief-push-jobs-dev"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "MOBILE_PUSH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "vars": {
        "BRIEF_AUDIO_ENABLED": "false",
        "AUTH0_ISSUER": "https://auth.watchtower.damao.io/",
        "AUTH0_TENANT_DOMAIN": "dev-to70scnda2czaona.us.auth0.com",
        "AUTH0_AUDIENCE": "https://watchtower.damao.io/api",
        "AUTH0_WEB_CLIENT_ID": "xk9v7BQhHNo4Us27srWAifkxIZTtHPhL",
        "AUTH0_MOBILE_DEV_CLIENT_ID": "xVjFpJiKSjIgwf6we3IJ2V4ciQUIRvAU",
        "AUTH0_MOBILE_PROD_CLIENT_ID": "qdjaZq0j2lxZxcbSsPOqx8VKU6irFLKt",
        "MIMO_API_KEY": ""
      },
      "secrets": {
        "required": []
      },
      "triggers": {
        "crons": []
      },
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      }
    }
  }
}
