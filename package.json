{
  "name": "watchtower-daily-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler dev --env=\"\" --test-scheduled",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log vitest run",
    "test:web": "vitest run --config vitest.web.config.js",
    "test:watch": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log vitest",
    "build": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler deploy --env=\"\" --dry-run --outdir dist",
    "verify": "node scripts/verify.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "cf-typegen": "node scripts/cf-typegen.mjs",
    "db:migrate:local": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler d1 migrations apply DB --env=\"\" --local",
    "db:migrate:remote": "node scripts/disabled-mutation.mjs 'npm run db:migrate:dev or npm run db:migrate:prod'",
    "allowlist": "node scripts/allowlist.mjs",
    "cover:enqueue": "node --env-file=.env scripts/enqueue-cover.mjs",
    "brief:regenerate": "node scripts/regenerate-briefs.mjs",
    "deploy": "node scripts/disabled-mutation.mjs 'npm run release:prod'",
    "deploy:dev": "node scripts/disabled-mutation.mjs 'npm run release:dev'",
    "db:migrate:dev": "node scripts/release.mjs migrate:dev",
    "db:migrate:prod": "node scripts/release.mjs migrate:prod",
    "release:dev": "node scripts/release.mjs release:dev",
    "e2e:dev": "node scripts/release.mjs e2e:dev",
    "release:prod": "node scripts/release.mjs release:prod",
    "rollback:prod": "node scripts/release.mjs rollback:prod",
    "testflight:bump": "node scripts/release.mjs testflight:bump",
    "testflight:build": "node scripts/release.mjs testflight:build",
    "testflight:inspect": "node scripts/release.mjs testflight:inspect"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "happy-dom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  },
  "dependencies": {
    "jose": "6.1.2"
  }
}
