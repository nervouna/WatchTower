{
  "name": "watchtower-daily-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler dev --env=\"\" --test-scheduled",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log vitest run",
    "test:watch": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log vitest",
    "build": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler deploy --env=\"\" --dry-run --outdir dist",
    "cf-typegen": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler types --env=\"\"",
    "db:migrate:local": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler d1 migrations apply DB --env=\"\" --local",
    "db:migrate:remote": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler d1 migrations apply DB --env=\"\" --remote",
    "allowlist": "node scripts/allowlist.mjs",
    "deploy": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler.log wrangler deploy --env=\"\" --secrets-file .env",
    "deploy:dev": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler-dev.log wrangler deploy --env dev",
    "db:migrate:dev": "WRANGLER_LOG_PATH=/tmp/watchtower-wrangler-dev.log wrangler d1 migrations apply watchtower-daily-brief-dev-db --env dev --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  },
  "dependencies": {
    "jose": "6.1.2"
  }
}
